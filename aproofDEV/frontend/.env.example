# Browser → API routing (local dev)
# Leave VITE_API_BASE_URL empty so requests stay same-origin and the Vite proxy forwards to the backend.

# VITE_API_BASE_URL=

# Where the dev proxy sends /auth, /subjects, /health, /sandbox, etc. (pick one style):
# VITE_API_PROXY_TARGET=http://127.0.0.1:3040

# Or set only the port (used when VITE_API_PROXY_TARGET is unset):
# VITE_API_PORT=3040

# Same as backend override name (also works when exported in the shell):
# APROOF_PORT=3040
