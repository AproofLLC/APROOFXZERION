# =============================================================================
# AProof + Zerion Agent (Solana devnet) — example ONLY. Copy to `.env` (gitignored).
# Never commit real API keys, keypair JSON, or private material.
#
# Load order: `APROOF/.env` (package root) first; `process.cwd()/.env` overrides if cwd differs.
# See `src/config/load-aproof-env.ts`. Run `npm run zerion:readiness` from `APROOF/` for a safe report.
# Optional: `APROOF_DEBUG_ENV_KEYS=1` logs presence-only keys on API startup (never values).
# =============================================================================

# --- Database (default: embedded PGlite) ---
APROOF_DB_MODE=pglite
# PGLITE_DATA_DIR=./data/pglite
# On Windows + OneDrive repos, prefer e.g. PGLITE_DATA_DIR=%TEMP%\aproof-pglite
# DATABASE_URL=postgresql://user:password@localhost:5432/aproof

# Optional HTTP bind (defaults in `src/config/runtime-env.ts`)
# PORT=3040
# HOST=0.0.0.0

# =============================================================================
# Zerion Agent — live devnet execution (required for integration_ready)
# Values below are intentionally empty or non-secret placeholders — fill in `.env` locally.
# =============================================================================
ZERION_API_KEY=
ZERION_CLI_PATH=
ZERION_AGENT_WALLET_ADDRESS=
ZERION_AGENT_KEYPAIR_PATH=
ZERION_AUTHORIZED_RECIPIENT_ADDRESS=
ZERION_CONTINUITY_RECIPIENT_ADDRESS=
ZERION_ALLOWED_CHAIN=solana-devnet
ZERION_MAX_SPEND_USD=5
ZERION_APPROVED_ASSETS=SOL,USDC

# =============================================================================
# Solana devnet — anchor + RPC (required for anchor_ready / integration)
# =============================================================================
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_MODE=solana-devnet
APROOF_ENV=solana-devnet
SOLANA_KEYPAIR_PATH=
# SOLANA_CLUSTER=devnet
SOLANA_MIN_BALANCE_LAMPORTS=10000000
# SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
# SOLANA_AUTOCREATE_DEVNET_WALLET=true
# SOLANA_AUTO_AIRDROP_DEVNET=true

# --- Optional sandbox demo subject key ---
# APROOF_SUBJECT_ID=zerion-agent

# --- First-time wallet files (gitignored under `.local/`) ---
# npm run devnet:wallet:bootstrap    → anchor keypair help
# npm run zerion:wallet:generate     → agent execution keypair (prints pubkey only)

# --- Schema / seeds ---
# npm run db:migrate && npm run seed && npm run db:setup

# Optional: e2e TCP Postgres
# E2E_DATABASE_URL=postgresql://user:password@localhost:5432/aproof
