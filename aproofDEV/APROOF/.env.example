# --- Recommended local dev: embedded Postgres (no install) ---
APROOF_DB_MODE=pglite
# PGLITE_DATA_DIR=./data/pglite
# On Windows + OneDrive repos, prefer e.g. PGLITE_DATA_DIR=%TEMP%\aproof-pglite

# If you see Postgres 58P01 / missing base/* files, the PGlite folder is corrupt — stop the API, then:
#   npm run dev:db:reset
# See docs/DEV-DB-RESET.md

# --- Or use a real Postgres server ---
# DATABASE_URL=postgresql://user:password@localhost:5432/aproof
# Optional Docker: docker compose up -d db  (see docker-compose.yml)

# Schema: edit src/db/schema → npm run db:generate → commit drizzle/
# Apply: npm run db:migrate   (uses PGlite when APROOF_DB_MODE=pglite)
# First-time: npm run db:setup  (migrate + demo seed)

# Optional: e2e against TCP Postgres (default e2e uses in-memory PGlite)
# E2E_DATABASE_URL=postgresql://user:password@localhost:5432/aproof

# Optional HTTP bind
# PORT=3000
# HOST=0.0.0.0

# Optional real Solana devnet anchoring (default mode is sandbox-mock when ANCHOR_MODE is unset)
# ANCHOR_MODE=solana-devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_CLUSTER=devnet
# SOLANA_KEYPAIR_PATH=APROOF/.local/solana/anchor-devnet.json
# SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
# SOLANA_AUTOCREATE_DEVNET_WALLET=true
# SOLANA_AUTO_AIRDROP_DEVNET=true
# SOLANA_MIN_BALANCE_LAMPORTS=10000000
