{
  "name": "aproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/apply-migrations.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "dev:db:reset": "tsx scripts/dev-reset-pglite.ts",
    "dev:verify:routes": "tsx scripts/verify-dashboard-routes.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx src/main.ts",
    "dev:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-live-dev.ps1",
    "kill:ports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-repo-ports.ps1",
    "kill:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-all-dev-ports.ps1",
    "package:clean": "node scripts/release-bundle.mjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "seed": "tsx src/scripts/seed-demo.ts",
    "seed:live": "tsx src/scripts/seed-live-test-subjects.ts",
    "solana:devnet:wallet:init": "tsx src/scripts/solana-devnet-wallet-init.ts",
    "solana:devnet:wallet:balance": "tsx src/scripts/solana-devnet-wallet-balance.ts",
    "anchor:devnet:test": "tsx src/scripts/anchor-devnet-test.ts",
    "anchor:devnet:smoke": "tsx src/scripts/anchor-devnet-pipeline-test.ts",
    "anchor:devnet:pipeline-test": "tsx src/scripts/anchor-devnet-pipeline-test.ts",
    "subject:register": "tsx src/scripts/register-test-subject.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run e2e",
    "test:predemo": "vitest run e2e/investor-demo-readiness.e2e.test.ts",
    "test:readiness": "vitest run e2e/subject-readiness.e2e.test.ts e2e/real-subject-readiness.e2e.test.ts e2e/investor-demo-readiness.e2e.test.ts",
    "test:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-live-tests.ps1",
    "test:watch": "vitest",
    "stress:api": "node scripts/stress-api-load.mjs",
    "stress:inject": "vitest run e2e/stress-inject-burst.e2e.test.ts",
    "verify:package": "npm run typecheck && npm run build && npm run test",
    "verify:all": "npm run typecheck && npm run build && npm run test && npm run test:e2e && npm run stress:inject"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
