# Fake shape for demos — copy to `.env` manually; NEVER commit real secrets.
# All values below are placeholders except the public devnet RPC URL.

ZERION_API_KEY=replace_me
ZERION_CLI_PATH=<repo>/APROOF/scripts/aproof-agent-devnet-execute.mjs
ZERION_AGENT_WALLET_ADDRESS=replace_me_after_wallet_generate
ZERION_AGENT_KEYPAIR_PATH=<repo>/APROOF/.local/zerion-agent-keypair.json
ZERION_AUTHORIZED_RECIPIENT_ADDRESS=
ZERION_CONTINUITY_RECIPIENT_ADDRESS=
ZERION_ALLOWED_CHAIN=solana-devnet
ZERION_MAX_SPEND_USD=5
ZERION_APPROVED_ASSETS=SOL,USDC

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=<repo>/APROOF/.local/solana/anchor-devnet.json
ANCHOR_MODE=solana-devnet
APROOF_ENV=solana-devnet
SOLANA_MIN_BALANCE_LAMPORTS=10000000
